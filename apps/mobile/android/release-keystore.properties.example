# Ehliyet Akademi — RELEASE İMZALAMA ŞABLONU
#
# Bu dosyayı `key.properties` adıyla KOPYALAYIN ve değerleri doldurun.
# `key.properties` ve `*.jks` Git'e GİRMEZ (`android/.gitignore` zorluyor) — gerçek değerleri
# ASLA bu şablona yazmayın.
#
# Anahtarı üretme (bir kez):
#   keytool -genkey -v \
#     -keystore ~/keys/ehliyet-akademi-upload.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -alias upload
#
# Tam anlatım: PLAY_CONSOLE_SETUP.md §2
#
# ⚠️ ANAHTAR DEPOSUNU KAYBETMEYİN. Play App Signing açıksa uygulama kurtarılabilir (upload key
#    reset talebi, günler sürer); kapalıysa uygulamayı BİR DAHA GÜNCELLEYEMEZSİNİZ.
#    Anahtar deposunu ve parolaları bir parola yöneticisinde yedekleyin.

# Anahtar deposunun TAM yolu. Git deposunun DIŞINDA tutun (ör. ~/keys/…).
storeFile=

# Anahtar deposu parolası.
storePassword=

# Anahtar takma adı (yukarıdaki komutta `upload`).
keyAlias=

# Anahtar parolası (genelde storePassword ile aynı).
keyPassword=
