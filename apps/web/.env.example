# Ehliyet Akademi — sunucu ortam değişkenleri ŞABLONU
#
# BU DOSYA GİZLİ DEĞER İÇERMEZ. Gerçek değerler `.env.local` (Git dışı) ve Vercel ortam
# değişkenlerinde tutulur. Örnek/sahte değer bile YAZILMAZ — CI'daki gitleaks taraması
# gerçekçi görünen dizgileri sır sanıp yapıyı kırabilir.
#
# Ayrıntılı açıklama: ENV_TEMPLATE.md

# ── Zorunlu ────────────────────────────────────────────────────────────────
# Postgres bağlantısı (Neon/Vercel). Yoksa Vercel'de hesap uçları 503 döner.
DATABASE_URL=

# ── Google ile giriş (Beta Faz 2) ──────────────────────────────────────────
# ID token'ın `aud` doğrulaması bununla yapılır.
# DİKKAT: Bu, Firebase'in **WEB** istemci kimliğidir — Android istemci DEĞİL.
# Yanlış verilirse mobil tarafta idToken null döner ve giriş sessizce başarısız olur.
# Kaynak: Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri
GOOGLE_SERVER_CLIENT_ID=

# Kayıt amaçlı; sunucu doğrulamasında kullanılmaz.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── AI Koç ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── E-posta ────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# ── Ödeme ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENT_PROVIDER=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
GOOGLE_PLAY_SA_JSON=

# ── Yönetim / işletim ──────────────────────────────────────────────────────
ADMIN_EMAILS=
ADMIN_EMAIL_PATTERN=
NEXT_PUBLIC_SITE_URL=
LOG_LEVEL=
SENTRY_DSN=

# ── YALNIZ GELİŞTİRME — üretimde ASLA ayarlanmaz ───────────────────────────
# IAP_DEV_ACCEPT=
# RATE_LIMIT_DISABLED=
