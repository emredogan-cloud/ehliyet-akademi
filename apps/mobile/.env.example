# Ehliyet Akademi — MOBİL derleme değişkenleri ŞABLONU
#
# BU DOSYA GİZLİ DEĞER İÇERMEZ. Örnek/sahte değer bile YAZILMAZ — CI'daki gitleaks taraması
# gerçekçi görünen dizgileri sır sanıp yapıyı kırabilir.
#
# Flutter'da `.env` dosyası ÇALIŞMA ZAMANINDA OKUNMAZ. Buradaki değerler derleme zamanında
# `--dart-define` ile verilir:
#
#   flutter build appbundle --release \
#     --dart-define=GOOGLE_SERVER_CLIENT_ID=... \
#     --dart-define=REVENUECAT_PUBLIC_KEY=...
#
# KURAL: bu değerlerin HİÇBİRİ ZORUNLU DEĞİLDİR. Verilmezse uygulama ÇÖKMEZ; ilgili yüzey
# dürüst bir "yapılandırılmadı" durumu gösterir. Bu davranış testle korunuyor
# (`test/billing_test.dart`, `test/google_auth_test.dart`).
#
# Ayrıntılı açıklama: ENV_TEMPLATE.md · REVENUECAT_SETUP.md · GOOGLE_AUTH_SETUP.md

# ── Google ile giriş (Beta Faz 2) ──────────────────────────────────────────
# `google_sign_in`'a `serverClientId` olarak verilir.
# DİKKAT: Firebase'in **WEB** istemci kimliğidir — Android istemci DEĞİL. Yanlış verilirse
# idToken null döner ve giriş sessizce başarısız olur (GOOGLE_AUTH_SETUP.md §4).
GOOGLE_SERVER_CLIENT_ID=

# ── RevenueCat (Beta Faz 3) ────────────────────────────────────────────────
# Android **Public SDK key**. RevenueCat → Project settings → API keys.
# Verilmezse RevenueCat ağ geçidi hiç seçilmez; uygulama mevcut in_app_purchase yolunda çalışır.
# Secret API key BURAYA GİRMEZ — o yalnız sunucudadır (ENV_TEMPLATE.md §1.3).
REVENUECAT_PUBLIC_KEY=

# Teşhis/kayıt amaçlı. RevenueCat → Project settings → Project ID.
REVENUECAT_PROJECT_ID=

# Uygulamanın sorduğu TEK yetki. Verilmezse `premium` varsayılır.
# Ömür boyu paket de, aylık/yıllık abonelik de AYNI yetkiyi açar (REVENUECAT_SETUP.md §3.1).
REVENUECAT_ENTITLEMENT=

# Abonelik ürün kimlikleri. Ürün sahibi ömür boyu modelde kalmaya karar verirse bu iki satır
# BOŞ KALIR ve kod bunu dürüstçe karşılar — abonelik paketi hiç gösterilmez.
REVENUECAT_MONTHLY_PRODUCT=
REVENUECAT_YEARLY_PRODUCT=

# ── İsteğe bağlı ───────────────────────────────────────────────────────────
# Farklı bir arka uca yönlendirmek için (varsayılan: üretim).
API_BASE_URL=
